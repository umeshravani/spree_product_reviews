{
  "name": "@umeshravani/spree-product-reviews-dashboard",
  "version": "1.0.0",
  "description": "Native Spree 6 Dashboard plugin for Product Reviews administration",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.tsx",
  "types": "./src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./package.json": "./package.json"
