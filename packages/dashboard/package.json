{
  "name": "@umeshravani/spree-product-reviews-dashboard",
  "version": "1.0.0",
  "description": "Native Spree 6 Dashboard plugin for Product Reviews administration",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "spree": {
    "dashboard": {
      "plugin": true,
      "routes": "./src/routes"
    }
  },
  "peerDependencies": {
    "@spree/admin-sdk": ">=6.0.0 <7.0.0-0",
    "@spree/dashboard-core": ">=6.0.0 <7.0.0-0",
    "@spree/dashboard-ui": ">=6.0.0 <7.0.0-0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "i18next": "^26.0.0",
    "lucide-react": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-i18next": "^17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.3.5"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  }
}
