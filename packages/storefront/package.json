{
  "name": "@umeshravani/spree-product-reviews-storefront",
  "version": "2.0.0",
  "description": "Production storefront components and Store API client for Spree Product Reviews",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
